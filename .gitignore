# ==============================================================================
# TasksManager Comprehensive .gitignore
# Prevents accidental leakage of secrets, credentials, build artifacts & caches
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Secret Keys (CRITICAL SECURITY)
.env
.env*
*.env
*.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json
id_rsa*
id_ed25519*

# Next.js & TypeScript Build Outputs
.next/
*/.next/
dist/
*/dist/
build/
*/build/
out/
*/out/
*.tsbuildinfo
next-env.d.ts

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# Temporary Scripts, Scratchpads & Test Dumps
scratch*
test_*
*.tmp
*.temp
out.txt
server/check-db.js

# Export Archives & Media Dumps
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Test Coverage & Frameworks
coverage/
.nyc_output/

# Cloud & Hosting Providers
.vercel/
.serverless/

# Prompt Files & Notes
MediaQueryPrompt.md

# Agent Artifacts
.agents/
skills-lock.json


# Generated AI Documentation
TasksManager_AI_Architecture.pdf
TasksManager_AI_Architecture.md
