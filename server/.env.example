# ==============================================================================
# TasksManager Server Environment Variables (DO NOT COMMIT REAL SECRETS)
# Copy this file to .env and replace placeholders with your actual values.
# ==============================================================================

# Primary MongoDB Connection URI
# Local: mongodb://localhost:27017/taskmanager
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/taskmanager

# Port the Express server listens on
PORT=4000

# Client origin for CORS (e.g., http://localhost:3000)
CLIENT_URL=http://localhost:3000

# OpenAI API Key (Optional, for AI drafts)
OPENAI_API_KEY=your_openai_api_key_here
