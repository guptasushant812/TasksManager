# ==============================================================================
# TasksManager Environment Variables Template (DO NOT COMMIT REAL SECRETS)
# ==============================================================================

## Server (server/.env)
# Primary MongoDB Connection URI (Local development or MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/taskmanager

# Server Port
PORT=4000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# OpenAI API Key (Optional, for AI task breakdown & auto-fill)
OPENAI_API_KEY=your_openai_api_key_here

## Client (client/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
